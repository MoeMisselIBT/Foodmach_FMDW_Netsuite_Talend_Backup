    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET XACT_ABORT ON;&#xD;&#xA;BEGIN TRANSACTION;&#xD;&#xA;&#xD;&#xA;WITH tsl AS (   -- the view's SELECT, word for word&#xD;&#xA;    SELECT t.TimesheetLineId, t.EmployeeId, t.StartDateTime, t.EndDateTime, t.Status,&#xD;&#xA;           t.LocationId, t.FullyQualifiedLocationName, t.WorkTypeId, t.WorkType,&#xD;&#xA;           t.PayCategoryId, t.LeaveCategoryId, t.ClassificationId, t.Units, t.Rate,&#xD;&#xA;           t.Comments, t.ExternalId, t.Source, t.SubmittedByUser,&#xD;&#xA;        MAX(CASE WHEN v.DimensionId = 5862 THEN v.ValueName END) AS [HourType],&#xD;&#xA;        MAX(CASE WHEN v.DimensionId = 5859 THEN v.ValueName END) AS [Module],&#xD;&#xA;        MAX(CASE WHEN v.DimensionId = 5861 THEN v.ValueName END) AS [Project]&#xD;&#xA;    FROM integration_database.integration.timesheetline t&#xD;&#xA;    LEFT JOIN integration_database.integration.timesheetlinedimensionvalue x ON x.TimesheetLineId = t.TimesheetLineId&#xD;&#xA;    LEFT JOIN integration_database.integration.dimensionvalue v ON v.DimensionValueId = x.DimensionValueId&#xD;&#xA;    GROUP BY t.TimesheetLineId, t.EmployeeId, t.StartDateTime, t.EndDateTime, t.Status,&#xD;&#xA;           t.LocationId, t.FullyQualifiedLocationName, t.WorkTypeId, t.WorkType,&#xD;&#xA;           t.PayCategoryId, t.LeaveCategoryId, t.ClassificationId, t.Units, t.Rate,&#xD;&#xA;           t.Comments, t.ExternalId, t.Source, t.SubmittedByUser&#xD;&#xA;),&#xD;&#xA;src AS (        -- your original SELECT&#xD;&#xA;    SELECT&#xD;&#xA;        ehts.TimesheetLineId, ehts.EmployeeId, ehts.EmployeeExternalId, ehts.FirstName, ehts.Surname,&#xD;&#xA;        ehts.Status, ehts.Location, ehts.WorkType, ehts.Classification, ehts.StartDateTime,&#xD;&#xA;        ehts.EndDateTime, ehts.ActualStartDateTime, ehts.ActualEndDateTime, ehts.DurationHours,&#xD;&#xA;        ehts.DurationExclBreaksHours, ehts.BreakDurationHours, ehts.TimeVarianceHours,&#xD;&#xA;        ehts.NumberOfBreaks, ehts.Units, ehts.UnitType, ehts.ShiftConditions,&#xD;&#xA;        ehts.ShiftConditionShortCodes, ehts.BreaksJson, ehts.Comments,&#xD;&#xA;        ehts.ConsolidatedWithTimesheetLineId, ehts.ReviewedBy, ehts.Gross, ehts.NetEarnings,&#xD;&#xA;        ehts.Super, ehts.Payg, ehts.EmployerLiabilities, ehts.TotalCost, ehts.TotalCostVariance,&#xD;&#xA;        ehts.DateCreated, ehts.DateReviewed, ehts.LoadedAt,&#xD;&#xA;        CAST(tsl.HourType AS INT) AS HourType, CAST(tsl.Module AS FLOAT) AS Module, CAST(tsl.Project AS INT) AS Project&#xD;&#xA;    FROM integration_database.integration.eh_timesheet ehts&#xD;&#xA;    LEFT JOIN tsl ON tsl.TimesheetLineId = ehts.TimesheetLineId&#xD;&#xA;)&#xD;&#xA;MERGE fmdw.emphero_landing.empHero_timesheet_landing_test AS tgt&#xD;&#xA;USING src ON tgt.TimesheetLineId = src.TimesheetLineId&#xD;&#xA;&#xD;&#xA;-- already loaded -> refresh every column&#xD;&#xA;WHEN MATCHED THEN UPDATE SET&#xD;&#xA;    tgt.EmployeeId = src.EmployeeId, tgt.EmployeeExternalId = src.EmployeeExternalId,&#xD;&#xA;    tgt.FirstName = src.FirstName, tgt.Surname = src.Surname, tgt.Status = src.Status,&#xD;&#xA;    tgt.Location = src.Location, tgt.WorkType = src.WorkType, tgt.Classification = src.Classification,&#xD;&#xA;    tgt.StartDateTime = src.StartDateTime, tgt.EndDateTime = src.EndDateTime,&#xD;&#xA;    tgt.ActualStartDateTime = src.ActualStartDateTime, tgt.ActualEndDateTime = src.ActualEndDateTime,&#xD;&#xA;    tgt.DurationHours = src.DurationHours, tgt.DurationExclBreaksHours = src.DurationExclBreaksHours,&#xD;&#xA;    tgt.BreakDurationHours = src.BreakDurationHours, tgt.TimeVarianceHours = src.TimeVarianceHours,&#xD;&#xA;    tgt.NumberOfBreaks = src.NumberOfBreaks, tgt.Units = src.Units, tgt.UnitType = src.UnitType,&#xD;&#xA;    tgt.ShiftConditions = src.ShiftConditions, tgt.ShiftConditionShortCodes = src.ShiftConditionShortCodes,&#xD;&#xA;    tgt.BreaksJson = src.BreaksJson, tgt.Comments = src.Comments,&#xD;&#xA;    tgt.ConsolidatedWithTimesheetLineId = src.ConsolidatedWithTimesheetLineId,&#xD;&#xA;    tgt.ReviewedBy = src.ReviewedBy, tgt.Gross = src.Gross, tgt.NetEarnings = src.NetEarnings,&#xD;&#xA;    tgt.Super = src.Super, tgt.Payg = src.Payg, tgt.EmployerLiabilities = src.EmployerLiabilities,&#xD;&#xA;    tgt.TotalCost = src.TotalCost, tgt.TotalCostVariance = src.TotalCostVariance,&#xD;&#xA;    tgt.DateCreated = src.DateCreated, tgt.DateReviewed = src.DateReviewed, tgt.LoadedAt = src.LoadedAt,&#xD;&#xA;    tgt.HourType = src.HourType, tgt.Module = src.Module, tgt.Project = src.Project&#xD;&#xA;&#xD;&#xA;-- new -> add it&#xD;&#xA;WHEN NOT MATCHED BY TARGET THEN INSERT (&#xD;&#xA;    TimesheetLineId, EmployeeId, EmployeeExternalId, FirstName, Surname, Status, Location,&#xD;&#xA;    WorkType, Classification, StartDateTime, EndDateTime, ActualStartDateTime, ActualEndDateTime,&#xD;&#xA;    DurationHours, DurationExclBreaksHours, BreakDurationHours, TimeVarianceHours, NumberOfBreaks,&#xD;&#xA;    Units, UnitType, ShiftConditions, ShiftConditionShortCodes, BreaksJson, Comments,&#xD;&#xA;    ConsolidatedWithTimesheetLineId, ReviewedBy, Gross, NetEarnings, Super, Payg,&#xD;&#xA;    EmployerLiabilities, TotalCost, TotalCostVariance, DateCreated, DateReviewed, LoadedAt,&#xD;&#xA;    HourType, Module, Project&#xD;&#xA;) VALUES (&#xD;&#xA;    src.TimesheetLineId, src.EmployeeId, src.EmployeeExternalId, src.FirstName, src.Surname,&#xD;&#xA;    src.Status, src.Location, src.WorkType, src.Classification, src.StartDateTime,&#xD;&#xA;    src.EndDateTime, src.ActualStartDateTime, src.ActualEndDateTime, src.DurationHours,&#xD;&#xA;    src.DurationExclBreaksHours, src.BreakDurationHours, src.TimeVarianceHours,&#xD;&#xA;    src.NumberOfBreaks, src.Units, src.UnitType, src.ShiftConditions,&#xD;&#xA;    src.ShiftConditionShortCodes, src.BreaksJson, src.Comments,&#xD;&#xA;    src.ConsolidatedWithTimesheetLineId, src.ReviewedBy, src.Gross, src.NetEarnings,&#xD;&#xA;    src.Super, src.Payg, src.EmployerLiabilities, src.TotalCost, src.TotalCostVariance,&#xD;&#xA;    src.DateCreated, src.DateReviewed, src.LoadedAt,&#xD;&#xA;    src.HourType, src.Module, src.Project&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;COMMIT;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
