    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH tsl AS (&#xD;&#xA;    SELECT t.TimesheetLineId, t.EmployeeId, t.StartDateTime, t.EndDateTime, t.Status,&#xD;&#xA;           t.LocationId, t.FullyQualifiedLocationName, t.WorkTypeId, t.WorkType,&#xD;&#xA;           t.PayCategoryId, t.LeaveCategoryId, t.ClassificationId, t.Units, t.Rate,&#xD;&#xA;           t.Comments, t.ExternalId, t.Source, t.SubmittedByUser,&#xD;&#xA;        MAX(CASE WHEN v.DimensionId = 5862 THEN v.ValueName END) AS [Hour Type],&#xD;&#xA;        MAX(CASE WHEN v.DimensionId = 5859 THEN v.ValueName END) AS [Module],&#xD;&#xA;        MAX(CASE WHEN v.DimensionId = 5861 THEN v.ValueName END) AS [Project]&#xD;&#xA;    FROM integration_database.integration.timesheetline t&#xD;&#xA;    LEFT JOIN integration_database.integration.timesheetlinedimensionvalue x ON x.TimesheetLineId = t.TimesheetLineId&#xD;&#xA;    LEFT JOIN integration_database.integration.dimensionvalue v ON v.DimensionValueId = x.DimensionValueId&#xD;&#xA;    GROUP BY t.TimesheetLineId, t.EmployeeId, t.StartDateTime, t.EndDateTime, t.Status,&#xD;&#xA;           t.LocationId, t.FullyQualifiedLocationName, t.WorkTypeId, t.WorkType,&#xD;&#xA;           t.PayCategoryId, t.LeaveCategoryId, t.ClassificationId, t.Units, t.Rate,&#xD;&#xA;           t.Comments, t.ExternalId, t.Source, t.SubmittedByUser&#xD;&#xA;),&#xD;&#xA;src AS (&#xD;&#xA;    SELECT&#xD;&#xA;        ehts.TimesheetLineId, ehts.EmployeeId, ehts.EmployeeExternalId, ehts.FirstName, ehts.Surname,&#xD;&#xA;        ehts.Status, ehts.Location, ehts.WorkType, ehts.Classification, ehts.StartDateTime,&#xD;&#xA;        ehts.EndDateTime, ehts.ActualStartDateTime, ehts.ActualEndDateTime, ehts.DurationHours,&#xD;&#xA;        ehts.DurationExclBreaksHours, ehts.BreakDurationHours, ehts.TimeVarianceHours,&#xD;&#xA;        ehts.NumberOfBreaks, ehts.Units, ehts.UnitType, ehts.ShiftConditions,&#xD;&#xA;        ehts.ShiftConditionShortCodes, ehts.BreaksJson, ehts.Comments,&#xD;&#xA;        ehts.ConsolidatedWithTimesheetLineId, ehts.ReviewedBy, ehts.Gross, ehts.NetEarnings,&#xD;&#xA;        ehts.Super, ehts.Payg, ehts.EmployerLiabilities, ehts.TotalCost, ehts.TotalCostVariance,&#xD;&#xA;        ehts.DateCreated, ehts.DateReviewed, ehts.LoadedAt,&#xD;&#xA;        tsl.[Hour Type], tsl.Module, tsl.Project&#xD;&#xA;    FROM integration_database.integration.eh_timesheet ehts&#xD;&#xA;    LEFT JOIN tsl ON tsl.TimesheetLineId = ehts.TimesheetLineId&#xD;&#xA;)&#xD;&#xA;SELECT * FROM src&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
