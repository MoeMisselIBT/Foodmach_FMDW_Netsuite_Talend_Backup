    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:REPOSITORY_SCHEMA_TYPE" value="_7_NhMKA9EfGq3IYnFJCINg - timesheetlinedimensionvalue" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;timesheetlinedimensionvalue&quot;"/>
    <elementParameter field="CHECK" name="IDENTITY_INSERT" value="false"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET XACT_ABORT ON;&#xD;&#xA;&#xD;&#xA;-- 1. Stop before changing anything if any line has a bad DimensionValueIds&#xD;&#xA;--    (anything other than blank/NULL or a JSON array of whole numbers)&#xD;&#xA;IF EXISTS (&#xD;&#xA;    SELECT 1&#xD;&#xA;    FROM integration_database.integration.timesheetline t&#xD;&#xA;    WHERE DATALENGTH(t.DimensionValueIds) > 0                      -- not NULL or truly empty&#xD;&#xA;      AND (&#xD;&#xA;            LEFT(LTRIM(t.DimensionValueIds), 1) &lt;> '['            -- not an array&#xD;&#xA;         OR EXISTS (SELECT 1 FROM OPENJSON(t.DimensionValueIds) j&#xD;&#xA;                    WHERE j.type &lt;> 2                             -- not a number&#xD;&#xA;                       OR j.value LIKE '%[^0-9-]%')               -- not a whole number&#xD;&#xA;          )&#xD;&#xA;)&#xD;&#xA;    THROW 50000, 'Bad DimensionValueIds found - nothing was written.', 1;&#xD;&#xA;&#xD;&#xA;BEGIN TRANSACTION;&#xD;&#xA;&#xD;&#xA;-- 2. Remove the existing links for every line being rebuilt&#xD;&#xA;DELETE x&#xD;&#xA;FROM integration_database.integration.timesheetlinedimensionvalue x&#xD;&#xA;WHERE EXISTS (SELECT 1&#xD;&#xA;              FROM integration_database.integration.timesheetline t&#xD;&#xA;              WHERE t.TimesheetLineId = x.TimesheetLineId);&#xD;&#xA;&#xD;&#xA;-- 3. Insert one row per (line, dimension value)&#xD;&#xA;INSERT INTO integration_database.integration.timesheetlinedimensionvalue (TimesheetLineId, DimensionValueId)&#xD;&#xA;SELECT DISTINCT t.TimesheetLineId, CAST(j.value AS bigint)&#xD;&#xA;FROM integration_database.integration.timesheetline t&#xD;&#xA;CROSS APPLY OPENJSON(NULLIF(t.DimensionValueIds, '')) j;&#xD;&#xA;&#xD;&#xA;COMMIT;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;trustServerCertificate=true;&quot;" show="false"/>
    <elementParameter field="CHECK" name="ACTIVE_DIR_AUTH" value="false" show="false"/>
    <elementParameter field="CLOSED_LIST" name="ACTIVE_DIR_AUTH_MODE" value="PASSWORD" show="false"/>
    <elementParameter field="CHECK" name="ENABLE_ALWAYS_ENCRYPTED" value="false" show="false"/>
    <elementParameter field="TEXT" name="KEYSTORE_PRINCIPAL_ID" value="" show="false"/>
    <elementParameter field="PASSWORD" name="KEYSTORE_SECRET" value="" show="false"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="COLUMN_LIST" name="RECORD_SET_COLUMN" value="TimesheetLineId" show="false"/>
    <elementParameter field="CHECK" name="USE_PREPAREDSTATEMENT" value="false"/>
