  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="160" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_6" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;//---- What happened on this page ----&#xD;&#xA;Integer httpStatus   = (Integer)globalMap.get(&quot;tsl_lastStatus&quot;);&#xD;&#xA;Integer rowsThisPage = (Integer)globalMap.get(&quot;tExtractJSONFields_5_NB_LINE&quot;);&#xD;&#xA;if (rowsThisPage == null) {&#xD;&#xA; rowsThisPage = 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Integer pageSize = (Integer)globalMap.get(&quot;tsl_pageSize&quot;);&#xD;&#xA;Integer skip     = (Integer)globalMap.get(&quot;tsl_skip&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Timesheet lines: skip=&quot; + skip + &quot; status=&quot; + httpStatus + &quot; rows=&quot; + rowsThisPage);&#xD;&#xA;&#xD;&#xA;//---- Rate limited (429): wait, then retry the SAME page ----&#xD;&#xA;if (httpStatus != null &amp;&amp; httpStatus == 429) {&#xD;&#xA;&#xD;&#xA; Integer retries = (Integer)globalMap.get(&quot;tsl_retries&quot;);&#xD;&#xA; if (retries == null) {&#xD;&#xA;     retries = 0;&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; if (retries >= 5) {&#xD;&#xA;     throw new RuntimeException(&quot;Employment Hero kept returning 429 at skip=&quot; + skip + &quot; after 5 retries.&quot;);&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; globalMap.put(&quot;tsl_retries&quot;, retries + 1);&#xD;&#xA; System.out.println(&quot;Rate limited. Waiting 2 seconds, then retrying skip=&quot; + skip);&#xD;&#xA; Thread.sleep(2000);&#xD;&#xA;&#xD;&#xA; // Don't change skip, and don't stop the loop: the same page is requested again&#xD;&#xA;&#xD;&#xA;//---- Any other error: stop the job, don't pretend it was the last page ----&#xD;&#xA;} else if (httpStatus == null || httpStatus != 200) {&#xD;&#xA;&#xD;&#xA; throw new RuntimeException(&quot;Employment Hero returned HTTP &quot; + httpStatus + &quot; at skip=&quot; + skip);&#xD;&#xA;&#xD;&#xA;//---- Success: next page, or finish ----&#xD;&#xA;} else {&#xD;&#xA;&#xD;&#xA; globalMap.put(&quot;tsl_retries&quot;, 0);   // reset the retry counter after a good page&#xD;&#xA;&#xD;&#xA; if (rowsThisPage &lt; pageSize) {&#xD;&#xA;     globalMap.put(&quot;tsl_hasMorePages&quot;, false);       // last page&#xD;&#xA;     int totalRows = skip + rowsThisPage;&#xD;&#xA;     System.out.println(&quot;Timesheet lines | finished | total rows fetched = &quot; + totalRows);&#xD;&#xA; } else {&#xD;&#xA;     globalMap.put(&quot;tsl_skip&quot;, skip + pageSize);     // next page&#xD;&#xA;     Thread.sleep(300);                              // pause, to stay under ~5 requests per second&#xD;&#xA; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//---- Rate limiter: always wait 250 ms before the next call (max 4 calls per second) ----&#xD;&#xA;if ((Boolean)globalMap.get(&quot;tsl_hasMorePages&quot;)) {&#xD;&#xA;  Thread.sleep(250);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//---- Safety net ----&#xD;&#xA;if ((Integer)globalMap.get(&quot;tsl_skip&quot;) >= 20000) {&#xD;&#xA; throw new RuntimeException(&quot;Timesheet lines pagination exceeded 20,000 records.&quot;);&#xD;&#xA;}&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="increment values"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_6"/>
  </node>
