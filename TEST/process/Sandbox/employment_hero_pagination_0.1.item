    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="globalMap.put(&quot;errJob&quot;, input_row.job);&#xD;&#xA;globalMap.put(&quot;errComponent&quot;, input_row.origin);&#xD;&#xA;globalMap.put(&quot;errorMsg&quot;, input_row.message == null ? &quot;&quot; : input_row.message.replace(&quot;\\&quot;, &quot;\\\\&quot;).replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;).replaceAll(&quot;[\\r\\n]+&quot;, &quot; &quot;));&#xD;&#xA;System.out.println(&quot;CAUGHT [&quot; + input_row.type + &quot;] in &quot; + input_row.origin + &quot;: &quot; + input_row.message);&#xD;&#xA;System.out.println(&quot;[&quot; + input_row.moment + &quot;] &quot;&#xD;&#xA;&#x9;    + (input_row.type == null ? &quot;&quot; : input_row.type.toUpperCase())&#xD;&#xA;&#x9;    + &quot; | priority &quot; + input_row.priority&#xD;&#xA;&#x9;    + &quot; | code &quot; + input_row.code&#xD;&#xA;&#x9;    + &quot; | &quot; + input_row.origin&#xD;&#xA;&#x9;    + &quot; | &quot; + input_row.message);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1"/>
  </node>
