  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="0" posY="-240">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_2" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="java.util.Date today = TalendDate.getCurrentDate();&#xD;&#xA;String from = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, TalendDate.addDate(today, -Integer.parseInt(context.lookbackDays), &quot;dd&quot;));&#xD;&#xA;&#xD;&#xA;// Report (/report/timesheet): ToDate is INCLUSIVE -> yesterday&#xD;&#xA;if (context.eh_ts_fromDate == null || context.eh_ts_fromDate.isEmpty()) {&#xD;&#xA;    context.eh_ts_fromDate = from;&#xD;&#xA;    context.eh_ts_toDate   = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, TalendDate.addDate(today, -1, &quot;dd&quot;));&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Timesheet lines (/timesheet): &quot;lt&quot; is EXCLUSIVE -> today&#xD;&#xA;if (context.tsl_fromDate == null || context.tsl_fromDate.isEmpty()) {&#xD;&#xA;    context.tsl_fromDate = from;&#xD;&#xA;    context.tsl_toDate   = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, today);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;eh_timesheet:  &quot; + context.eh_ts_fromDate + &quot; to &quot; + context.eh_ts_toDate + &quot; (inclusive)&quot;);&#xD;&#xA;System.out.println(&quot;timesheetline: &quot; + context.tsl_fromDate + &quot; to before &quot; + context.tsl_toDate + &quot; (less than)&quot;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="set dates for the last week"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_2"/>
  </node>
