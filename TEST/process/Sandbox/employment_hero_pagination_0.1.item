  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="200" posY="-240">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Get the current date and time when the job runs&#xD;&#xA;java.util.Date today = TalendDate.getCurrentDate();&#xD;&#xA;&#xD;&#xA;//true if manualFromDate has a value (not null and not just spaces)&#xD;&#xA;boolean hasFrom = context.manualFromDate != null &amp;&amp; !context.manualFromDate.trim().isEmpty();&#xD;&#xA;//true if manualToDate has a value (not null and not just spaces)&#xD;&#xA;boolean hasTo   = context.manualToDate   != null &amp;&amp; !context.manualToDate.trim().isEmpty();&#xD;&#xA;&#xD;&#xA;//Show what was entered&#xD;&#xA;System.out.println(&quot;manualFromDate = '&quot; + context.manualFromDate + &quot;' (filled: &quot; + hasFrom + &quot;)&quot;);&#xD;&#xA;System.out.println(&quot;manualToDate   = '&quot; + context.manualToDate   + &quot;' (filled: &quot; + hasTo   + &quot;)&quot;);&#xD;&#xA;&#xD;&#xA;//First day to pull (always inclusive)&#xD;&#xA;java.util.Date fromDate;&#xD;&#xA;//Last day to pull (always inclusive) - the +1 for the exclusive API is added further down&#xD;&#xA;java.util.Date toDate;&#xD;&#xA;&#xD;&#xA;//---------- Decide which date range to use ----------&#xD;&#xA;if (hasFrom &amp;&amp; hasTo) {&#xD;&#xA;  // MANUAL MODE: both manual dates were filled in&#xD;&#xA;  System.out.println(&quot;Scenario: BOTH manual dates filled -> MANUAL mode&quot;);&#xD;&#xA;&#xD;&#xA;  // Convert the typed text (e.g. &quot;2026-08-01&quot;) into a real Date; trim() removes stray spaces&#xD;&#xA;  fromDate = TalendDate.parseDate(&quot;yyyy-MM-dd&quot;, context.manualFromDate.trim());&#xD;&#xA;  toDate   = TalendDate.parseDate(&quot;yyyy-MM-dd&quot;, context.manualToDate.trim());&#xD;&#xA;&#xD;&#xA;  // Safety check: stop the job if the start date is after the end date&#xD;&#xA;  if (fromDate.after(toDate)) {&#xD;&#xA;      System.out.println(&quot;ERROR: manualFromDate is after manualToDate - stopping job&quot;);&#xD;&#xA;      throw new RuntimeException(&quot;manualFromDate (&quot; + context.manualFromDate + &quot;) is after manualToDate (&quot; + context.manualToDate + &quot;)&quot;);&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  System.out.println(&quot;Manual dates are valid&quot;);&#xD;&#xA;&#xD;&#xA;} else if (hasFrom == true &amp;&amp; hasTo == false) {&#xD;&#xA;  // From filled but To empty&#xD;&#xA;  System.out.println(&quot;Scenario: ONLY manualFromDate filled -> ERROR, manualToDate is missing&quot;);&#xD;&#xA;  throw new RuntimeException(&quot;manualToDate is blank. Fill in BOTH manualFromDate and manualToDate, or leave both blank.&quot;);&#xD;&#xA;&#xD;&#xA;} else if (hasFrom == false &amp;&amp; hasTo == true) {&#xD;&#xA;  // To filled but From empty&#xD;&#xA;  System.out.println(&quot;Scenario: ONLY manualToDate filled -> ERROR, manualFromDate is missing&quot;);&#xD;&#xA;  throw new RuntimeException(&quot;manualFromDate is blank. Fill in BOTH manualFromDate and manualToDate, or leave both blank.&quot;);&#xD;&#xA;&#xD;&#xA;} else {&#xD;&#xA;  // DEFAULT MODE: no manual dates, so use the rolling window&#xD;&#xA;  System.out.println(&quot;Scenario: NO manual dates -> DEFAULT mode (last &quot; + context.lookbackDays + &quot; days)&quot;);&#xD;&#xA;&#xD;&#xA;  // Start = today minus lookbackDays (stored as text, so convert to a number first)&#xD;&#xA;  fromDate = TalendDate.addDate(today, -Integer.parseInt(context.lookbackDays), &quot;dd&quot;);&#xD;&#xA;  // End = yesterday (today's timesheets aren't complete yet)&#xD;&#xA;  toDate   = TalendDate.addDate(today, -1, &quot;dd&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//---------- Fill the 4 API date variables ----------&#xD;&#xA;&#xD;&#xA;///report/timesheet: ToDate is INCLUSIVE, so use the last day as-is&#xD;&#xA;context.eh_ts_fromDate = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, fromDate);&#xD;&#xA;context.eh_ts_toDate   = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, toDate);&#xD;&#xA;&#xD;&#xA;///timesheet: the &quot;lt&quot; (less than) filter is EXCLUSIVE, so use the day AFTER the last day&#xD;&#xA;context.tsl_fromDate = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, fromDate);&#xD;&#xA;context.tsl_toDate   = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, TalendDate.addDate(toDate, 1, &quot;dd&quot;));&#xD;&#xA;&#xD;&#xA;//---------- Log the final windows so you can verify them in the run output ----------&#xD;&#xA;System.out.println(&quot;eh_timesheet:  &quot; + context.eh_ts_fromDate + &quot; to &quot; + context.eh_ts_toDate + &quot; (inclusive)&quot;);&#xD;&#xA;System.out.println(&quot;timesheetline: &quot; + context.tsl_fromDate + &quot; to before &quot; + context.tsl_toDate + &quot; (less than)&quot;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="set dates for the last week"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
