    <elementParameter field="CLOSED_LIST" name="DRIVER" value="MSSQL_PROP" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;51980&quot;" show="false"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="&quot;teto_landing&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;fmdw&quot;" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;sa&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:8FmEmWJgTMihRcWo0rWi63XtJiMJ3wBxnBOMNNgWVQHOqClNUKu6FI1AGQ==" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;tblReceiverLog__ct&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH ranked_receiver AS (&#xD;&#xA;    SELECT&#xD;&#xA;        -- Grabs all updates from the change table in landing, orders them by header__timestamp desc,&#xD;&#xA;        -- and numbers the rows latest to earliest per ReceiverLogID, so we can pick the latest update per record.&#xD;&#xA;        teto_landing.tblReceiverLog__ct.header__change_oper,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.header__timestamp,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogID,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.PurchaseDetailID,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.QtyReceived,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.[Date],&#xD;&#xA;        teto_landing.tblReceiverLog__ct.DateCreated,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.BatchID,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom1,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom2,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom3,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom4,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom5,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom6,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom7,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ReceiverLogCustom8,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.RaisedByEmployee,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ProcessScheduleID,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.ProcessScheduleDetailID,&#xD;&#xA;        teto_landing.tblReceiverLog__ct.PackingSlipNumber,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY ReceiverLogID ORDER BY header__timestamp DESC, header__change_seq DESC) AS rn&#xD;&#xA;    FROM teto_landing.tblReceiverLog__ct&#xD;&#xA;    WHERE header__change_oper = 'U'&#xD;&#xA;    AND header__timestamp > DATEADD(DAY, -7, GETDATE())&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;    header__change_oper, header__timestamp, ReceiverLogID, PurchaseDetailID, QtyReceived,&#xD;&#xA;    [Date], DateCreated, BatchID, ReceiverLogCustom1, ReceiverLogCustom2,&#xD;&#xA;    ReceiverLogCustom3, ReceiverLogCustom4, ReceiverLogCustom5, ReceiverLogCustom6,&#xD;&#xA;    ReceiverLogCustom7, ReceiverLogCustom8, RaisedByEmployee, ProcessScheduleID,&#xD;&#xA;    ProcessScheduleDetailID, PackingSlipNumber&#xD;&#xA;FROM ranked_receiver r&#xD;&#xA;WHERE r.rn = 1&#xD;&#xA;  AND NOT EXISTS (&#xD;&#xA;      SELECT 1&#xD;&#xA;      FROM integration_database.integration.tblReceiverLog_integration x&#xD;&#xA;      WHERE x.ReceiverLogID = r.ReceiverLogID&#xD;&#xA;  );&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
