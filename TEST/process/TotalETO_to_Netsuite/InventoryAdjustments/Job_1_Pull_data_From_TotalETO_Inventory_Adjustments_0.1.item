  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="360" posY="440">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_1" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tMSSqlRow" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.102 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Databases/DB Specifics/MS_SQL_Server" show="false"/>
    <elementParameter field="CHECK" name="START" value="false" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="true" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="true" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="false" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tMSSqlRow" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Talend-Studio-20260708_1430-V8.0.1\Talend-Studio-20260708_1430-V8.0.1\configuration\lib\java" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:PROPERTY_TYPE" value="REPOSITORY" show="false"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:REPOSITORY_PROPERTY_TYPE" value="_7_NhMKA9EfGq3IYnFJCINg" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER" value="MSSQL_PROP" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;192.168.2.46&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;51980&quot;" show="false"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="&quot;integration&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;integration_database&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;sa&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:P847NCl1VtDFqM+wjAzZNm5AB0PnEbo6lw1+NfxieDzOlXwAdqFwU5NpXQ==" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;dimension&quot;"/>
    <elementParameter field="CHECK" name="IDENTITY_INSERT" value="false"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET NOCOUNT ON;&#xD;&#xA;SET XACT_ABORT ON;&#xD;&#xA;&#xD;&#xA;DECLARE @Actions TABLE (Action NVARCHAR(10));&#xD;&#xA;&#xD;&#xA;BEGIN TRY&#xD;&#xA;&#xD;&#xA;    ;WITH src AS (&#xD;&#xA;        SELECT&#xD;&#xA;         I.ProjectID,&#xD;&#xA;         I.SpecID,&#xD;&#xA;         I.ItemID,&#xD;&#xA;         E.ItemCompanyID,&#xD;&#xA;         C.CategoryDescription AS ItemCategory,&#xD;&#xA;         I.InventoryLocation,&#xD;&#xA;         I.ReceivedDate,&#xD;&#xA;         SUM(I.PullQty) AS PullQty,&#xD;&#xA;         SUM(I.CostingValue) AS CostingValue,&#xD;&#xA;         I.PullPrice&#xD;&#xA;        FROM&#xD;&#xA;         fmdw.teto_bronze.tblInventoryPullDetails I&#xD;&#xA;        LEFT JOIN&#xD;&#xA;         fmdw.teto_bronze.tblEngItemMaster E ON I.ItemID = E.ItemID&#xD;&#xA;        LEFT JOIN&#xD;&#xA;         fmdw.teto_bronze.tlkpItemMaster_Categories C ON E.ItemCategory = C.ItemCategory&#xD;&#xA;        WHERE I.FulfilledStatus = 1&#xD;&#xA;          AND I.ReceivedDate >= (&#xD;&#xA;                SELECT ISNULL(MAX(ReceivedDate), '1900-01-01')&#xD;&#xA;                FROM integration_database.integration.tblInventoryAdjustment_integration)&#xD;&#xA;        GROUP BY I.ProjectID, I.SpecID, I.ItemID, I.PullPrice, E.ItemCompanyID, C.CategoryDescription, I.InventoryLocation, I.FulfilledStatus, I.ReceivedDate&#xD;&#xA;    )&#xD;&#xA;    MERGE integration_database.integration.tblInventoryAdjustment_integration WITH (HOLDLOCK) AS tgt&#xD;&#xA;    USING src&#xD;&#xA;       ON  tgt.ProjectID                  = src.ProjectID&#xD;&#xA;       AND tgt.SpecID                     = src.SpecID&#xD;&#xA;       AND tgt.ItemID                     = src.ItemID&#xD;&#xA;       AND ISNULL(tgt.ItemCompanyID, '')  = ISNULL(src.ItemCompanyID, '')&#xD;&#xA;       AND ISNULL(tgt.ItemCategory, '')   = ISNULL(src.ItemCategory, '')&#xD;&#xA;       AND tgt.InventoryLocation          = src.InventoryLocation&#xD;&#xA;       AND tgt.ReceivedDate               = src.ReceivedDate&#xD;&#xA;       AND ISNULL(tgt.PullPrice, -1)      = ISNULL(src.PullPrice, -1)&#xD;&#xA;    WHEN MATCHED AND ISNULL(tgt.LoadedIntoNetsuite, 0) = 0&#xD;&#xA;       AND (ISNULL(tgt.PullQty, 0)      &lt;> ISNULL(src.PullQty, 0)&#xD;&#xA;         OR ISNULL(tgt.CostingValue, 0) &lt;> ISNULL(src.CostingValue, 0)) THEN&#xD;&#xA;        UPDATE SET tgt.PullQty      = src.PullQty,&#xD;&#xA;                   tgt.CostingValue = src.CostingValue&#xD;&#xA;    WHEN NOT MATCHED BY TARGET THEN&#xD;&#xA;        INSERT (ProjectID, SpecID, ItemID, ItemCompanyID, ItemCategory, InventoryLocation,&#xD;&#xA;                ReceivedDate, PullQty, CostingValue, PullPrice)&#xD;&#xA;        VALUES (src.ProjectID, src.SpecID, src.ItemID, src.ItemCompanyID, src.ItemCategory, src.InventoryLocation,&#xD;&#xA;                src.ReceivedDate, src.PullQty, src.CostingValue, src.PullPrice)&#xD;&#xA;    OUTPUT $action INTO @Actions;&#xD;&#xA;&#xD;&#xA;    SELECT&#xD;&#xA;        'Success' AS Status,&#xD;&#xA;        COUNT(CASE WHEN Action = 'INSERT' THEN 1 END) AS RowsInserted,&#xD;&#xA;        COUNT(CASE WHEN Action = 'UPDATE' THEN 1 END) AS RowsUpdated,&#xD;&#xA;        CAST(NULL AS NVARCHAR(4000)) AS ErrorMessage&#xD;&#xA;    FROM @Actions;&#xD;&#xA;&#xD;&#xA;END TRY&#xD;&#xA;BEGIN CATCH&#xD;&#xA;&#xD;&#xA;    IF @@TRANCOUNT > 0 ROLLBACK;&#xD;&#xA;&#xD;&#xA;    SELECT&#xD;&#xA;        'Failed' AS Status,&#xD;&#xA;        0 AS RowsInserted,&#xD;&#xA;        0 AS RowsUpdated,&#xD;&#xA;        ERROR_MESSAGE() AS ErrorMessage;&#xD;&#xA;&#xD;&#xA;END CATCH;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;trustServerCertificate=true;&quot;" show="false"/>
    <elementParameter field="CHECK" name="ACTIVE_DIR_AUTH" value="false" show="false"/>
    <elementParameter field="CLOSED_LIST" name="ACTIVE_DIR_AUTH_MODE" value="PASSWORD" show="false"/>
    <elementParameter field="CHECK" name="ENABLE_ALWAYS_ENCRYPTED" value="false" show="false"/>
    <elementParameter field="TEXT" name="KEYSTORE_PRINCIPAL_ID" value="" show="false"/>
    <elementParameter field="PASSWORD" name="KEYSTORE_SECRET" value="" show="false"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="true"/>
    <elementParameter field="COLUMN_LIST" name="RECORD_SET_COLUMN" value="rs"/>
    <elementParameter field="CHECK" name="USE_PREPAREDSTATEMENT" value="false"/>
    <elementParameter field="TABLE" name="SET_PREPAREDSTATEMENT_PARAMETERS" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
