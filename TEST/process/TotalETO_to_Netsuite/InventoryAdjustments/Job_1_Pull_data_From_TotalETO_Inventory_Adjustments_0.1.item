  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="360" posY="440">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_1" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:PROPERTY_TYPE" value="REPOSITORY" show="false"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:REPOSITORY_PROPERTY_TYPE" value="_7_NhMKA9EfGq3IYnFJCINg" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER" value="MSSQL_PROP" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;192.168.2.46&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;51980&quot;" show="false"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="&quot;integration&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;integration_database&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;sa&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:P847NCl1VtDFqM+wjAzZNm5AB0PnEbo6lw1+NfxieDzOlXwAdqFwU5NpXQ==" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;dimension&quot;"/>
    <elementParameter field="CHECK" name="IDENTITY_INSERT" value="false"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET NOCOUNT ON;&#xD;&#xA;SET XACT_ABORT ON;&#xD;&#xA;&#xD;&#xA;DECLARE @RowsInserted INT = 0;&#xD;&#xA;&#xD;&#xA;BEGIN TRY&#xD;&#xA;&#xD;&#xA;    INSERT INTO integration_database.integration.tblInventoryAdjustment_pull_detail_lines_integration&#xD;&#xA;        (PullDetailID, ProjectID, SpecID, ItemID, ItemCompanyID, ItemCategory,&#xD;&#xA;         InventoryLocation, FulfilledDate, PullQty, CostingValue, PullPrice,&#xD;&#xA;         EmpFirstName, EmpLastName)&#xD;&#xA;    SELECT&#xD;&#xA;     I.PullDetailID,&#xD;&#xA;     I.ProjectID,&#xD;&#xA;     I.SpecID,&#xD;&#xA;     I.ItemID,&#xD;&#xA;     E.ItemCompanyID,&#xD;&#xA;     C.CategoryDescription AS ItemCategory,&#xD;&#xA;     I.InventoryLocation,&#xD;&#xA;     I.FulfilledDate,&#xD;&#xA;     I.PullQty,&#xD;&#xA;     I.CostingValue,&#xD;&#xA;     I.PullPrice,&#xD;&#xA;     te.EmpFirstName,&#xD;&#xA;     te.EmpLastName&#xD;&#xA;    FROM fmdw.teto_bronze.tblInventoryPullDetails I&#xD;&#xA;    LEFT JOIN fmdw.teto_bronze.tblEngItemMaster E ON I.ItemID = E.ItemID&#xD;&#xA;    LEFT JOIN fmdw.teto_bronze.tlkpItemMaster_Categories C ON E.ItemCategory = C.ItemCategory&#xD;&#xA;    LEFT JOIN fmdw.teto_bronze.tblEmployee te ON te.EmployeeID = I.FulFilledByEmployeeID&#xD;&#xA;    WHERE I.FulfilledStatus = 1&#xD;&#xA;&#x9;AND I.FulfilledDate > '&quot; + context.inventory_cutoff_date + &quot;'&#xD;&#xA;      AND NOT EXISTS (&#xD;&#xA;            SELECT 1&#xD;&#xA;            FROM integration_database.integration.tblInventoryAdjustment_pull_detail_lines_integration t&#xD;&#xA;            WHERE t.PullDetailID = I.PullDetailID&#xD;&#xA;      );&#xD;&#xA;&#xD;&#xA;    SET @RowsInserted = @@ROWCOUNT;&#xD;&#xA;&#xD;&#xA;    SELECT&#xD;&#xA;        'Success' AS Status,&#xD;&#xA;        @RowsInserted AS RowsInserted,&#xD;&#xA;        CAST(NULL AS NVARCHAR(4000)) AS ErrorMessage;&#xD;&#xA;&#xD;&#xA;END TRY&#xD;&#xA;BEGIN CATCH&#xD;&#xA;&#xD;&#xA;    IF @@TRANCOUNT > 0 ROLLBACK;&#xD;&#xA;&#xD;&#xA;    SELECT&#xD;&#xA;        'Failed' AS Status,&#xD;&#xA;        0 AS RowsInserted,&#xD;&#xA;        ERROR_MESSAGE() AS ErrorMessage;&#xD;&#xA;&#xD;&#xA;END CATCH;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;trustServerCertificate=true;&quot;" show="false"/>
    <elementParameter field="CHECK" name="ACTIVE_DIR_AUTH" value="false" show="false"/>
    <elementParameter field="CLOSED_LIST" name="ACTIVE_DIR_AUTH_MODE" value="PASSWORD" show="false"/>
    <elementParameter field="CHECK" name="ENABLE_ALWAYS_ENCRYPTED" value="false" show="false"/>
    <elementParameter field="TEXT" name="KEYSTORE_PRINCIPAL_ID" value="" show="false"/>
