  <note opaque="false" posX="280" posY="400" sizeHeight="161" sizeWidth="201" text="This job pulls PO headers&#xD;&#xA;from the integration table&#xD;&#xA;and grabs the latest data&#xD;&#xA;from the source tables. It &#xD;&#xA;constructs the payload and&#xD;&#xA;sends it to Netsuite. &#xD;&#xA;"/>
  <note opaque="false" posX="1480" posY="40" sizeHeight="201" sizeWidth="241" text="Scan POH_ct for POs with&#xD;&#xA;printed or emailed = 1.&#xD;&#xA;&#xD;&#xA;Store these records in an integration&#xD;&#xA;table for processing. &#xD;&#xA;&#xD;&#xA;These are&#xD;&#xA;the POs that need to be synced&#xD;&#xA;to Netsuite"/>
