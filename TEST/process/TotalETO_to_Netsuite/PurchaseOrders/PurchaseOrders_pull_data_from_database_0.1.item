    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH ranked_header AS (&#xD;&#xA;    SELECT&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.header__change_oper,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.header__timestamp,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderID,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseRev,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseSupplierID,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseDate,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTerms,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseShip,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseFOB,&#xD;&#xA;        --teto_landing.tblPurchaseOrderHeader__ct.PurchaseNotes,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseMisc,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseShipTo,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseActive,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseDateRequired,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseNotes2,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchasePrinted,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseNotes3,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseCurr,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseCurrRate,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTax1,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTax2,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.Port,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.FOBNotes,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.ReportAlternateID,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom1,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom2,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom3,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom4,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom5,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom6,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom7,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseOrderHeaderCustom8,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseDateRevised,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.BuyerID,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseEmailed,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.CompoundTax,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTax1Name,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTax2Name,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTax1GLAccountID,&#xD;&#xA;        teto_landing.tblPurchaseOrderHeader__ct.PurchaseTax2GLAccountID,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY PurchaseOrderID ORDER BY header__timestamp DESC) AS rn&#xD;&#xA;    FROM teto_landing.tblPurchaseOrderHeader__ct&#xD;&#xA;    WHERE header__change_oper = 'U'&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;    header__change_oper, header__timestamp, PurchaseOrderID, PurchaseRev, PurchaseSupplierID,&#xD;&#xA;    PurchaseDate, PurchaseTerms, PurchaseShip, PurchaseFOB, PurchaseMisc,&#xD;&#xA;    PurchaseShipTo, PurchaseActive, PurchaseDateRequired, PurchaseNotes2, PurchasePrinted,&#xD;&#xA;    PurchaseNotes3, PurchaseCurr, PurchaseCurrRate, PurchaseTax1, PurchaseTax2, Port, FOBNotes,&#xD;&#xA;    ReportAlternateID, PurchaseOrderHeaderCustom1, PurchaseOrderHeaderCustom2,&#xD;&#xA;    PurchaseOrderHeaderCustom3, PurchaseOrderHeaderCustom4, PurchaseOrderHeaderCustom5,&#xD;&#xA;    PurchaseOrderHeaderCustom6, PurchaseOrderHeaderCustom7, PurchaseOrderHeaderCustom8,&#xD;&#xA;    PurchaseDateRevised, BuyerID, PurchaseEmailed, CompoundTax, PurchaseTax1Name,&#xD;&#xA;    PurchaseTax2Name, PurchaseTax1GLAccountID, PurchaseTax2GLAccountID, rn&#xD;&#xA;FROM ranked_header&#xD;&#xA;WHERE rn = 1&#xD;&#xA;  AND (PurchasePrinted = 1 OR PurchaseEmailed = 1)&quot;"/>
