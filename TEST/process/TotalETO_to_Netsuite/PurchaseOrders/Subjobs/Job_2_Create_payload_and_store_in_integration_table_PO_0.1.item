    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT&#xD;&#xA;&#x9;PH.PurchaseSupplierID AS PurchaseSupplierID_POH,&#xD;&#xA;&#x9;PH.PurchaseDate AS PurchaseDate_POH,&#xD;&#xA;&#x9;PH.PurchaseTerms AS PurchaseTerms_POH,&#xD;&#xA;&#x9;PH.PurchaseNotes AS PurchaseNotes_POH,&#xD;&#xA;&#x9;PH.PurchaseShipTo AS PurchaseShipTo_POH, -- Add to payload Get the address&#xD;&#xA;&#x9;PH.PurchaseDateRequired AS PurchaseDateRequired_POH,&#xD;&#xA;&#x9;PH.PurchaseCurr AS PurchaseCurr_POH, -- Add to payload&#xD;&#xA;&#x9;PH.PurchaseCurrRate AS PurchaseCurrRate_POH, -- Add to payload&#xD;&#xA;&#x9;PH.PurchaseTax1 AS PurchaseTax1_POH, -- Add to payload&#xD;&#xA;&#x9;PH.PurchaseTax1Name AS PurchaseTax1Name_POH,&#xD;&#xA;&#x9;PH.BuyerID AS BuyerID_POH, -- Add to payload&#xD;&#xA;&#x9;E.EmpEmail as EmpEmail_E,&#xD;&#xA;&#x9;PD.PurchaseDetailID AS PurchaseDetailID_POD,&#xD;&#xA;&#x9;PD.PurchaseOrderID AS PurchaseOrderID_POD,&#xD;&#xA;&#x9;PD.ProjectID AS ProjectID_POD,-- Add to payload&#xD;&#xA;&#x9;PD.SpecID AS SpecID_POD, -- Add to payload&#xD;&#xA;&#x9;PD.ItemID AS ItemID_POD,&#xD;&#xA;&#x9;I.ItemCompanyID as  PartNumber_I, -- New column -- Add to payload&#xD;&#xA;&#x9;PD.PurchaseQty AS PurchaseQty_POD,&#xD;&#xA;&#x9;PD.PurchasePrice AS PurchasePrice_POD, -- Add to payload&#xD;&#xA;&#x9;PD.DateRequired AS DateRequired_POD, -- Add to payload&#xD;&#xA;&#x9;PD.PurchaseSupplierDescription AS PurchaseSupplierDescription_POD, -- Add to payload&#xD;&#xA;&#x9;PD.PurchaseUOM AS PurchaseUOM_POD, -- Add to payload&#xD;&#xA;&#x9;PD.DestInventoryLoc AS DestInventoryLoc_POD,&#xD;&#xA;&#x9;I.ItemDescription AS ItemDescription_I, -- Add to payload&#xD;&#xA;&#x9;C.CName AS CName_C,&#xD;&#xA;&#x9;C.CompanyCustom3 AS CompanyCustom3_C,&#xD;&#xA;&#x9;C2.SAddress1 as SAddress1_C2, -- Add to payload&#xD;&#xA;&#x9;C2.SAddress2 as SAddress2_C2, -- Add to payload&#xD;&#xA;&#x9;C2.SCity as SCity_C2,-- Add to payload&#xD;&#xA;&#x9;C2.SState as SState_C2, -- Add to payload&#xD;&#xA;&#x9;C2.SCountry as SCountry_C2, -- Add to payload&#xD;&#xA;IMC.ItemCategory AS ItemCategory_IMC,&#xD;&#xA;&#x9;IMC.CategoryDescription AS CategoryDescription_IMC,&#xD;&#xA;&#x9;IMC.CatergoryMajor AS CatergoryMajor_IMC,&#xD;&#xA;&#x9;IMC.CategoryCode AS CategoryCode_IMC,&#xD;&#xA;&#x9;IMC.ItemMasterGroupID AS ItemMasterGroupID_IMC,&#xD;&#xA;&#x9;IMC.ItemCategoryCustom1 AS ItemCategoryCustom1_IMC,&#xD;&#xA;&#x9;IMG.ItemMasterGroupName AS ItemMasterGroupName_IMG&#xD;&#xA;FROM&#xD;&#xA;&#x9;Foodmach_Training.dbo.tblPurchaseOrderDetails PD&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblPurchaseOrderHeader PH ON PD.PurchaseOrderID = PH.PurchaseOrderID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblCompany C ON PH.PurchaseSupplierID = C.CompanyID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblEngItemMaster I ON PD.ItemID = I.ItemID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblCompany C2 on PH.PurchaseShipTo = C2.CompanyID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblEmployee E on PH.BuyerID = E.EmployeeID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tlkpItemMaster_Categories IMC on I.ItemCategory = IMC.ItemCategory&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tlkpItemMaster_Group IMG on IMC.ItemMasterGroupID = IMG.ItemMasterGroupID &#xD;&#xA;WHERE&#x9;PD.PurchaseOrderID IN (&quot; + context.PO_ID_List + &quot;)&#xD;&#xA;&quot;&#xD;&#xA;&#xD;&#xA;&#x9;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
