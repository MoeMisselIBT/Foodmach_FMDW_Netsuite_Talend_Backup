    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT&#xD;&#xA;&#x9;PH.PurchaseSupplierID AS PurchaseSupplierID_POH,&#xD;&#xA;&#x9;PH.PurchaseDate AS PurchaseDate_POH,&#xD;&#xA;&#x9;PH.PurchaseTerms AS PurchaseTerms_POH,&#xD;&#xA;&#x9;PH.PurchaseNotes AS PurchaseNotes_POH,&#xD;&#xA;&#x9;PH.PurchaseShipTo AS PurchaseShipTo_POH,&#xD;&#xA;&#x9;PH.PurchaseDateRequired AS PurchaseDateRequired_POH,&#xD;&#xA;&#x9;PH.PurchaseCurr AS PurchaseCurr_POH,&#xD;&#xA;&#x9;PH.PurchaseCurrRate AS PurchaseCurrRate_POH,&#xD;&#xA;&#x9;PH.PurchaseTax1 AS PurchaseTax1_POH,&#xD;&#xA;&#x9;PH.PurchaseTax1Name AS PurchaseTax1Name_POH,&#xD;&#xA;&#x9;PH.BuyerID AS BuyerID_POH,&#xD;&#xA;&#x9;PD.PurchaseDetailID AS PurchaseDetailID_POD,&#xD;&#xA;&#x9;PD.PurchaseOrderID AS PurchaseOrderID_POD,&#xD;&#xA;&#x9;PD.ProjectID AS ProjectID_POD,&#xD;&#xA;&#x9;PD.SpecID AS SpecID_POD,&#xD;&#xA;&#x9;PD.ItemID AS ItemID_POD,&#xD;&#xA;&#x9;PD.PurchaseQty AS PurchaseQty_POD,&#xD;&#xA;&#x9;PD.PurchasePrice AS PurchasePrice_POD,&#xD;&#xA;&#x9;PD.DateRequired AS DateRequired_POD,&#xD;&#xA;&#x9;PD.PurchaseSupplierDescription AS PurchaseSupplierDescription_POD,&#xD;&#xA;&#x9;PD.PurchaseUOM AS PurchaseUOM_POD,&#xD;&#xA;&#x9;PD.DestInventoryLoc AS DestInventoryLoc_POD,&#xD;&#xA;&#x9;I.ItemDescription AS ItemDescription_I,&#xD;&#xA;&#x9;C.CName AS CName_C,&#xD;&#xA;&#x9;C.CompanyCustom3 AS CompanyCustom3_C&#xD;&#xA;FROM&#xD;&#xA;&#x9;Foodmach_Training.dbo.tblPurchaseOrderDetails PD&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblPurchaseOrderHeader PH ON PD.PurchaseOrderID = PH.PurchaseOrderID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblCompany C ON PH.PurchaseSupplierID = C.CompanyID&#xD;&#xA;&#x9;LEFT JOIN Foodmach_Training.dbo.tblEngItemMaster I ON PD.ItemID = I.ItemID&#xD;&#xA;WHERE&#x9;PD.PurchaseOrderID IN (&quot; + context.PO_ID_List + &quot;)&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
