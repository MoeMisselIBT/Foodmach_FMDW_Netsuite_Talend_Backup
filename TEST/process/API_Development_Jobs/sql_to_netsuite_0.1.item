    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_END" value="// end of the component, outside/closing the loop&#xA;System.out.println(&quot;Number of changes not synced with Netsuite: &quot; + countNotApplied);&#xD;&#xA;System.out.println(&quot;New inserts: &quot; + countToInsert);&#xD;&#xA;System.out.println(&quot;New updates: &quot; + countToUpdate);"/>
