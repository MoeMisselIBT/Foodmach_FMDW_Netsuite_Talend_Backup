    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET NOCOUNT ON;&#xD;&#xA;DECLARE @inserted TABLE (&#xD;&#xA;    CompanyID INT,&#xD;&#xA;    CName NVARCHAR(100),&#xD;&#xA;    CAddress1 NVARCHAR(255),&#xD;&#xA;    CAddress2 NVARCHAR(255),&#xD;&#xA;    CCity NVARCHAR(50),&#xD;&#xA;    CState NVARCHAR(50),&#xD;&#xA;    CZip NVARCHAR(50),&#xD;&#xA;    CCountry NVARCHAR(50),&#xD;&#xA;    CPhone NVARCHAR(50),&#xD;&#xA;    CFax NVARCHAR(50),&#xD;&#xA;    CDate DATETIME,&#xD;&#xA;    BAddress1 NVARCHAR(255),&#xD;&#xA;    BAddress2 NVARCHAR(255),&#xD;&#xA;    BCity NVARCHAR(50),&#xD;&#xA;    BState NVARCHAR(50),&#xD;&#xA;    BZip NVARCHAR(50),&#xD;&#xA;    BCountry NVARCHAR(50),&#xD;&#xA;    SAddress1 NVARCHAR(255),&#xD;&#xA;    SAddress2 NVARCHAR(255),&#xD;&#xA;    SCity NVARCHAR(50),&#xD;&#xA;    SState NVARCHAR(50),&#xD;&#xA;    SZip NVARCHAR(50),&#xD;&#xA;    SCountry NVARCHAR(50),&#xD;&#xA;    CWWWAddress NVARCHAR(255),&#xD;&#xA;    CTollFree NVARCHAR(50),&#xD;&#xA;    BSameAsMailing BIT,&#xD;&#xA;    SSameAsMailing BIT,&#xD;&#xA;    CHasAgent BIT,&#xD;&#xA;    CAccountingHoldCode INT,&#xD;&#xA;    CCompanyParent INT,&#xD;&#xA;    CDefaultShipVia INT,&#xD;&#xA;    CDefaultPartDiscount DECIMAL(9, 8),&#xD;&#xA;    CDefaultPartMargin DECIMAL(20, 10),&#xD;&#xA;    CDefaultTerms INT,&#xD;&#xA;    CAccVendorID NVARCHAR(50),&#xD;&#xA;    CAccCustomerID NVARCHAR(50),&#xD;&#xA;    CAccVendorTaxClass1 INT,&#xD;&#xA;    CAccCustomerGroupCode NVARCHAR(50),&#xD;&#xA;    CAccCustomerDisc DECIMAL(9, 8),&#xD;&#xA;    CompanyCustom1 NVARCHAR(MAX),&#xD;&#xA;    CompanyCustom2 NVARCHAR(MAX),&#xD;&#xA;    CompanyCustom3 DECIMAL(20, 6),&#xD;&#xA;    CompanyCustom4 DECIMAL(20, 6),&#xD;&#xA;    CompanyCustom5 DATETIME,&#xD;&#xA;    CompanyCustom6 DATETIME,&#xD;&#xA;    CompanyCustom7 BIT,&#xD;&#xA;    CompanyCustom8 BIT,&#xD;&#xA;    Legacy_CCountry NVARCHAR(50),&#xD;&#xA;    Legacy_BCountry NVARCHAR(50),&#xD;&#xA;    Legacy_SCountry NVARCHAR(50),&#xD;&#xA;    CActive BIT,&#xD;&#xA;    DefaultEmailAddress NVARCHAR(255),&#xD;&#xA;    ARTaxCategoryID INT&#xD;&#xA;);&#xD;&#xA;INSERT INTO &quot; + context.foodmach_database_name + &quot;.&quot; + context.foodmach_schema_name + &quot;.&quot; + context.foodmach_tblCompany_table_name + &quot; (&#xD;&#xA;    CName, CAddress1, CCity, CState, CZip, CCountry, CPhone, CFax, CDate,&#xD;&#xA;    BAddress1, BCity, BState, BZip, BCountry, SAddress1, SCity, SState, SZip,&#xD;&#xA;    SCountry, CWWWAddress, CDefaultTerms, CompanyCustom3,&#xD;&#xA;    DefaultEmailAddress, ARTaxCategoryID, CActive, CompanyCustom2&#xD;&#xA;)&#xD;&#xA;OUTPUT&#xD;&#xA;    inserted.CompanyID, inserted.CName, inserted.CAddress1, inserted.CAddress2, inserted.CCity,&#xD;&#xA;    inserted.CState, inserted.CZip, inserted.CCountry, inserted.CPhone, inserted.CFax, inserted.CDate,&#xD;&#xA;    inserted.BAddress1, inserted.BAddress2, inserted.BCity, inserted.BState, inserted.BZip, inserted.BCountry,&#xD;&#xA;    inserted.SAddress1, inserted.SAddress2, inserted.SCity, inserted.SState, inserted.SZip, inserted.SCountry,&#xD;&#xA;    inserted.CWWWAddress, inserted.CTollFree, inserted.BSameAsMailing, inserted.SSameAsMailing, inserted.CHasAgent,&#xD;&#xA;    inserted.CAccountingHoldCode, inserted.CCompanyParent, inserted.CDefaultShipVia, inserted.CDefaultPartDiscount,&#xD;&#xA;    inserted.CDefaultPartMargin, inserted.CDefaultTerms, inserted.CAccVendorID, inserted.CAccCustomerID,&#xD;&#xA;    inserted.CAccVendorTaxClass1, inserted.CAccCustomerGroupCode, inserted.CAccCustomerDisc,&#xD;&#xA;    inserted.CompanyCustom1, inserted.CompanyCustom2, inserted.CompanyCustom3, inserted.CompanyCustom4,&#xD;&#xA;    inserted.CompanyCustom5, inserted.CompanyCustom6, inserted.CompanyCustom7, inserted.CompanyCustom8,&#xD;&#xA;    inserted.Legacy_CCountry, inserted.Legacy_BCountry, inserted.Legacy_SCountry, inserted.CActive,&#xD;&#xA;    inserted.DefaultEmailAddress, inserted.ARTaxCategoryID&#xD;&#xA;INTO @inserted (&#xD;&#xA;    CompanyID, CName, CAddress1, CAddress2, CCity, CState, CZip, CCountry, CPhone, CFax, CDate,&#xD;&#xA;    BAddress1, BAddress2, BCity, BState, BZip, BCountry, SAddress1, SAddress2, SCity, SState, SZip, SCountry,&#xD;&#xA;    CWWWAddress, CTollFree, BSameAsMailing, SSameAsMailing, CHasAgent, CAccountingHoldCode, CCompanyParent,&#xD;&#xA;    CDefaultShipVia, CDefaultPartDiscount, CDefaultPartMargin, CDefaultTerms, CAccVendorID, CAccCustomerID,&#xD;&#xA;    CAccVendorTaxClass1, CAccCustomerGroupCode, CAccCustomerDisc, CompanyCustom1, CompanyCustom2, CompanyCustom3,&#xD;&#xA;    CompanyCustom4, CompanyCustom5, CompanyCustom6, CompanyCustom7, CompanyCustom8, Legacy_CCountry,&#xD;&#xA;    Legacy_BCountry, Legacy_SCountry, CActive, DefaultEmailAddress, ARTaxCategoryID&#xD;&#xA;)&#xD;&#xA;VALUES (&#xD;&#xA;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xD;&#xA;    1, 1, ?&#xD;&#xA;);&#xD;&#xA;SELECT * FROM @inserted;&quot;"/>
