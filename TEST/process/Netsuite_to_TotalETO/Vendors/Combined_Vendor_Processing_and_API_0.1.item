  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1760" posY="1120">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_14" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String pem = new String(Files.readAllBytes(Path.of(context.private_key_path)));&#xD;&#xA;String base64Key = pem&#xD;&#xA;        .replace(&quot;-----BEGIN PRIVATE KEY-----&quot;, &quot;&quot;)&#xD;&#xA;        .replace(&quot;-----END PRIVATE KEY-----&quot;, &quot;&quot;)&#xD;&#xA;        .replaceAll(&quot;\\s&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;byte[] keyBytes = Base64.getDecoder().decode(base64Key);&#xD;&#xA;PKCS8EncodedKeySpec spec = new PKCS8EncodedKeySpec(keyBytes);&#xD;&#xA;RSAPrivateKey privateKey = (RSAPrivateKey) KeyFactory.getInstance(&quot;RSA&quot;).generatePrivate(spec);&#xD;&#xA;&#xD;&#xA;String tokenUrl = &quot;https://&quot; + context.account_id + context.netsuite_token_api_url;&#xD;&#xA;long now = System.currentTimeMillis() / 1000;&#xD;&#xA;&#xD;&#xA;JWSHeader header = new JWSHeader.Builder(JWSAlgorithm.PS256)&#xD;&#xA;        .keyID(context.certificate_id)&#xD;&#xA;        .type(JOSEObjectType.JWT)&#xD;&#xA;        .build();&#xD;&#xA;&#xD;&#xA;JWTClaimsSet claims = new JWTClaimsSet.Builder()&#xD;&#xA;        .issuer(context.client_id)&#xD;&#xA;        .claim(&quot;scope&quot;, context.scope)&#xD;&#xA;        .audience(tokenUrl)&#xD;&#xA;        .issueTime(new Date(now * 1000))&#xD;&#xA;        .expirationTime(new Date((now + 300) * 1000))&#xD;&#xA;        .build();&#xD;&#xA;&#xD;&#xA;SignedJWT signedJWT = new SignedJWT(header, claims);&#xD;&#xA;signedJWT.sign(new RSASSASigner(privateKey));&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;client_assertion&quot;, signedJWT.serialize());&#xD;&#xA;globalMap.put(&quot;token_url&quot;, tokenUrl);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import com.nimbusds.jose.*;&#xD;&#xA;import com.nimbusds.jose.crypto.RSASSASigner;&#xD;&#xA;import com.nimbusds.jwt.JWTClaimsSet;&#xD;&#xA;import com.nimbusds.jwt.SignedJWT;&#xD;&#xA;import java.security.KeyFactory;&#xD;&#xA;import java.security.interfaces.RSAPrivateKey;&#xD;&#xA;import java.security.spec.PKCS8EncodedKeySpec;&#xD;&#xA;import java.nio.file.Files;&#xD;&#xA;import java.nio.file.Path;&#xD;&#xA;import java.util.Base64;&#xD;&#xA;import java.util.Date;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
