    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xD;&#xA;//output_row.success = input_row.success;&#xD;&#xA;//output_row.error = input_row.error;&#xD;&#xA;//output_row.body = input_row.body;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;context.rejectCount++;&#xD;&#xA;System.out.println(&quot;==========================================&quot;);&#xD;&#xA;System.out.println(&quot;Checking Filter Reject Status...&quot;);&#xD;&#xA;System.out.println(&quot;Total Rows Rejected: &quot; + context.rejectCount);&#xD;&#xA;System.out.println(&quot;==========================================&quot;);&#xD;&#xA;System.out.println(&quot;Failed to send CompanyCustom3 &quot; + input_row.CompanyCustom3 + &quot;to Netsuite. Netsuite error - &quot; + input_row.error);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;"/>
